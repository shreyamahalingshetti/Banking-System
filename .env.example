# ─────────────────────────────────────────────────────────────────────────────
# Example environment variables — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres connection
DB_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT signing secret (must be at least 32 characters)
JWT_SECRET=your-32-plus-character-jwt-secret-here-change-me

# Admin seed user (created on first startup if it does not exist)
ADMIN_EMAIL=admin@yourbank.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# CORS allowed origins (comma-separated, no spaces around commas)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
